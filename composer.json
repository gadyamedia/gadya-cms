{
    "name": "gadya/cms",
    "description": "A client-editable CMS for Laravel and Filament: live on-page editing, draft and publish, articles written with AI, SEO, forms, first-party analytics and team invitations.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "gadya/connect": "^0.5",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "intervention/image": "^3.0|^4.0",
        "laravel/ai": "^0.11",
        "league/html-to-markdown": "^5.1",
        "livewire/livewire": "^4.3",
        "spatie/laravel-image-optimizer": "^1.8",
        "spatie/laravel-package-tools": "^1.90"
    },
    "autoload": {
        "psr-4": {
            "Gadya\\Cms\\": "src/",
            "Gadya\\Cms\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gadya\\Cms\\GadyaCmsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "filament",
        "cms",
        "filament-plugin",
        "analytics",
        "page-builder",
        "inline-editing"
    ],
    "homepage": "https://github.com/gadyamedia/gadya-cms",
    "authors": [
        {
            "name": "Gadya Media",
            "email": "antony@gadyamedia.com"
        }
    ],
    "support": {
        "issues": "https://github.com/gadyamedia/gadya-cms/issues",
        "source": "https://github.com/gadyamedia/gadya-cms"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Gadya\\Cms\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "sync-docs": "cp docs/*.md resources/boost/skills/gadya-cms-development/references/",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "demo": [
            "@build",
            "@php -S 127.0.0.1:8000 -t vendor/orchestra/testbench-core/laravel/public vendor/orchestra/testbench-core/laravel/server.php"
        ]
    }
}
